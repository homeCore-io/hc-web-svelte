# Where homeCore is. The UI server passes /api/v1 and the event stream through to it.
HC_CORE_URL=http://127.0.0.1:8080
# Where the UI server keeps its own data (pages, preferences, files). A volume in the container.
HC_DATA_DIR=./data
# UI extensions' Catalog: the registry's signed index of them, and the key that signs it.
# HC_EXTENSIONS_INDEX=https://homecore.io/registry/extensions.json
# HC_REGISTRY_PUBLIC_KEY=d64zXOo99GE+uYAPbtbIwLUJHtBaACJB73cUppj93I8=
# Production only: the port the UI server listens on.
PORT=3000
