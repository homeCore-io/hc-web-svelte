{
	"name": "hc-web",
	"version": "0.1.9",
	"private": true,
	"type": "module",
	"license": "MIT OR Apache-2.0",
	"description": "The homeCore web app and the UI server beside it.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node server/index.js",
		"preview": "npm run build && npm start",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"format": "prettier --write .",
		"lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format:check": "prettier --check .",
		"budget": "node scripts/budget.js"
	},
	"devDependencies": {
		"@fontsource/figtree": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@lucide/svelte": "^1.57.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*",
		"#server/*": "./server/*"
	},
	"engines": {
		"node": ">=22"
	}
}
